# Copia questo file in .env o configura le variabili nell'ambiente Windows.
# Non inserire mai il token reale nel repository.
TELEGRAM_BOT_TOKEN=123456789:replace-with-BotFather-token
TELEGRAM_ALLOWED_CHAT_ID=123456789
GUARDIAN_POLL_SECONDS=3
GUARDIAN_RATE_LIMIT_PER_MINUTE=10
GUARDIAN_CONFIRMATION_TTL_SECONDS=60
GUARDIAN_AUDIT_LOG=%ProgramData%\TelegramPcGuardian\audit.jsonl
GUARDIAN_STOP_FILE=%ProgramData%\TelegramPcGuardian\STOP
